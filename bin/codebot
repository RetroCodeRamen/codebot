#!/usr/bin/env bash
# codebot: local-only ralph-loop coding agent (ollama + opencode)
set -uo pipefail
CODEBOT_HOME="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck disable=SC1091
source "$CODEBOT_HOME/config/codebot.env"
# shellcheck disable=SC1091
[[ -f "$CODEBOT_HOME/config/local.env" ]] && source "$CODEBOT_HOME/config/local.env"     # this machine's settings (not tracked by git)
OLLAMA_BIN="$CODEBOT_HOME/tools/ollama/bin/ollama"
OPENCODE_BIN="$CODEBOT_HOME/tools/node_modules/.bin/opencode"
export OLLAMA_HOST="127.0.0.1:$OLLAMA_PORT"
export OLLAMA_MODELS="$CODEBOT_HOME/models"
export OLLAMA_KEEP_ALIVE=30m OLLAMA_NUM_PARALLEL=1 OLLAMA_MAX_LOADED_MODELS=1
export LLAMA_ARG_CACHE_RAM=0     # Ollama's llama-server runner otherwise keeps up to 8 GiB of earlier prompts in RAM; codebot sends one request at a
                                 # time, and with a 30B model that cache grew 2 GB in 6 requests and went to swap (2026-10-20)
export OPENCODE_CONFIG="$CODEBOT_HOME/config/opencode.json"
THINK="${THINK:-on}"; [[ "$THINK" == off ]] && THINK_VARIANT=nothink || THINK_VARIANT=""
mkdir -p "$CODEBOT_HOME/logs" "$CODEBOT_HOME/projects"

# per-project mode: a folder under modes/<name>/ (mode.json + prompts + worker rules + memory + verifier helpers); no code change adds a mode
oc_setup() { # sets MODE_DIR, OC_CONFIG, OC_AGENT for the current project from its mode
  local mj req b dep need=0
  mj="$("$CODEBOT_HOME/bin/codebot-engine" mode-info "$NAME" --home "$CODEBOT_HOME" 2>&1)" || die "$mj"
  MODE_DIR="$CODEBOT_HOME/modes/$MODE"
  OC_CONFIG="$CODEBOT_HOME/$(jq -r '.opencode.config' <<< "$mj")"; OC_AGENT="$(jq -r '.opencode.agent' <<< "$mj")"
  for req in $(jq -r '.opencode.requires[]?' <<< "$mj"); do command -v "$req" >/dev/null || die "mode '$MODE' needs '$req' on PATH"; done
  b="$(jq -r '.opencode.build // empty' <<< "$mj")"
  if [[ -n "$b" ]]; then
    [[ -f "$OC_CONFIG" ]] || need=1
    for dep in $(jq -r '.opencode.build_deps[]?' <<< "$mj"); do [[ "$CODEBOT_HOME/$dep" -nt "$OC_CONFIG" ]] && need=1; done
    (( need )) && { "$CODEBOT_HOME/$b" >/dev/null || die "could not build $OC_CONFIG for mode $MODE"; }
  fi
  return 0
}
render_prompt() { # plan|work: the mode's prompt (a mode that extends another gets the base plus its additions)
  local q=(); [[ "$1" == plan && "${PLAN_STYLE:-grill}" == quick ]] && q=(--quick)
  render <("$CODEBOT_HOME/bin/codebot-engine" prompt-template "$NAME" "$1" --home "$CODEBOT_HOME" "${q[@]}")
}

die() { echo "codebot: $*" >&2; exit 1; }
sdir() { echo "$CODEBOT_HOME/projects/$1"; }
need_proj() { [[ -n "${1:-}" && -d "$(sdir "$1")" ]] || die "unknown project '${1:-}' (see: codebot list)"; }
load_proj() { need_proj "$1"; S="$(sdir "$1")"; NAME="$1"; MODE=code; WORKFLOW=""; source "$S/project.env"; RUNDIR="${RUNDIR:-$WORKDIR}"; oc_setup; }
alive() { # pidfile; for loop.pid also confirm the pid is really a codebot loop (pid reuse after reboot)
  [[ -f "$1" ]] && kill -0 "$(cat "$1")" 2>/dev/null || return 1
  [[ "$1" != *loop.pid ]] || tr '\0' ' ' < "/proc/$(cat "$1")/cmdline" 2>/dev/null | grep -q '__loop'; }

NTFY_TOKEN="${NTFY_TOKEN:-}"
ntfy_auth() { [[ -n "$NTFY_TOKEN" ]] && echo "Authorization: Bearer $NTFY_TOKEN" || echo "X-Codebot: 1"; }
egress_log() { # purpose [ok]: every byte the harness itself sends off-machine is listed here (codebot audit reads it)
  printf '{"ts":"%s","project":"%s","dest":"%s","purpose":"%s","ok":%s}\n' "$(date '+%FT%T')" "${NAME:-}" "$(sed -E 's#^[a-z]+://##; s#/.*##' <<< "$NTFY_SERVER")" "$1" "${2:-true}" >> "$CODEBOT_HOME/logs/egress.jsonl"
}
notify() { # title message priority tags [buttons=1]
  if [[ "${NTFY_ENABLED:-1}" == 0 ]]; then echo "(ntfy disabled: $1)" >&2; return 0; fi
  local acts=()
  if [[ "${5:-}" == 1 ]]; then
    local r="$NTFY_SERVER/$NTFY_TOPIC-reply"
    acts=(-H "Actions: http, Pause, $r, method=POST, body=pause, clear=false; http, Resume, $r, method=POST, body=resume, clear=false; http, Status, $r, method=POST, body=status, clear=false")
  fi
  if curl -s -m 15 -H "$(ntfy_auth)" -H "Title: $1" -H "Priority: ${3:-default}" -H "Tags: ${4:-robot}" "${acts[@]}" \
    --data-raw "$2" "$NTFY_SERVER/$NTFY_TOPIC" >/dev/null 2>&1; then egress_log notification; else echo "(ntfy send failed)" >&2; egress_log notification false; fi
}

# phone control: poll <topic>-reply. words pause/resume/stop/status act on the loop; anything else answers a BLOCKED question.
PHONE_LAST=$(date +%s); PHONE_T=-20
phone_tick() { # call often; polls at most every 20s
  [[ "${PHONE_CONTROL:-1}" == 0 ]] && return 0
  (( SECONDS - PHONE_T >= 20 )) || return 0; PHONE_T=$SECONDS; egress_log phone-poll
  local msgs m t txt
  msgs="$(curl -s -m 10 -H "$(ntfy_auth)" "$NTFY_SERVER/$NTFY_TOPIC-reply/json?poll=1&since=$PHONE_LAST" 2>/dev/null)" || return 0
  while IFS= read -r m; do
    [[ -n "$m" ]] || continue
    [[ "$(jq -r '.event // empty' <<< "$m" 2>/dev/null)" == message ]] || continue
    t=$(jq -r '.time' <<< "$m"); txt=$(jq -r '.message' <<< "$m")
    (( t > PHONE_LAST )) || continue; PHONE_LAST=$t
    echo "(phone: $txt)"
    case "$(tr 'A-Z' 'a-z' <<< "$txt" | xargs)" in
      pause)  "$0" pause "$NAME" >/dev/null; notify "codebot: $NAME paused" "Model unloaded. Send 'resume' to continue." low pause_button 1;;
      resume) "$0" resume "$NAME" >/dev/null; notify "codebot: $NAME resumed" "Back to work." low arrow_forward 1;;
      stop)   notify "codebot: $NAME stopping" "Loop stopped from phone." default stop_button; "$0" stop "$NAME" >/dev/null & ;;
      status) notify "codebot: $NAME status" "$(progress_text). $([[ -f "$S/PAUSE" ]] && echo PAUSED || echo running). $(head -c 200 "$S/STATUS" 2>/dev/null)" low information_source 1;;
      *) if has_blocked; then
           "$0" answer "$NAME" "$txt" >/dev/null; notify "codebot: $NAME" "Got your answer, continuing." low speech_balloon 1
         else notify "codebot: $NAME" "Nothing is waiting for an answer. Commands: pause, resume, stop, status." low question; fi;;
    esac
  done <<< "$msgs"
}

ensure_ollama() {
  curl -sf -m 2 "http://$OLLAMA_HOST/api/version" >/dev/null && return 0
  [[ -x "$OLLAMA_BIN" ]] || die "private ollama missing at $OLLAMA_BIN"
  setsid nohup "$OLLAMA_BIN" serve >> "$CODEBOT_HOME/logs/ollama.log" 2>&1 &
  for _ in $(seq 1 30); do curl -sf -m 2 "http://$OLLAMA_HOST/api/version" >/dev/null && break; sleep 1; done
  "$OLLAMA_BIN" list | grep -q "^$CODEBOT_MODEL" || "$OLLAMA_BIN" create "$CODEBOT_MODEL" -f "$CODEBOT_HOME/config/Modelfile"
}

render() { # template file -> stdout
  local t; t="$(cat "$1")"
  t="${t//\{\{WORKDIR\}\}/$RUNDIR}"; t="${t//\{\{STATE\}\}/$S}"
  t="${t//\{\{CODEBOT_HOME\}\}/$CODEBOT_HOME}"; t="${t//\{\{NAME\}\}/$NAME}"; t="${t//\{\{MODE_DIR\}\}/${MODE_DIR:-}}"
  if [[ "$t" == *"{{SIZING}}"* ]]; then t="${t//\{\{SIZING\}\}/$("$CODEBOT_HOME/bin/codebot-engine" sizing "$NAME" --home "$CODEBOT_HOME" 2>/dev/null || echo '(no history yet)')}"; fi
  printf '%s\n' "$t"
}

state_hash() {
  { cat "$S/PLAN.md" "$S/PROGRESS.md" 2>/dev/null
    git -C "$RUNDIR" rev-parse HEAD 2>/dev/null
    git -C "$RUNDIR" status --porcelain 2>/dev/null
    git -C "$RUNDIR" diff 2>/dev/null; } | md5sum | cut -d' ' -f1
}
progress_text() { if [[ "${WORKFLOW:-}" == drafts ]]; then eng status --short 2>/dev/null; else echo "$(tasks_done) done / $(tasks_left) left"; fi; }
# tolerant of stray prefixes the model sometimes writes (e.g. "^- [x]")
tasks_left() { grep -cE '^[^[:alnum:]]{0,3}[-*][[:space:]]+\[ \]' "$S/PLAN.md" 2>/dev/null || true; }
tasks_done() { grep -cE '^[^[:alnum:]]{0,3}[-*][[:space:]]+\[[xX]\]' "$S/PLAN.md" 2>/dev/null || true; }

cmd_setup() { ensure_ollama; echo "ollama up on :$OLLAMA_PORT"; "$OLLAMA_BIN" list; echo "ntfy: $NTFY_SERVER (topic in config/local.env, not shown)"; }

cmd_plan() {
  local name="" wd_arg="" mode="" a style="${PLAN_STYLE:-grill}" targets=() want_t=0
  for a in "$@"; do
    if (( want_t )); then targets+=("$a"); want_t=0; continue; fi
    case "$a" in --re) mode=re;; --mode=*) mode="${a#--mode=}";; --mode) mode="@next";; --target) want_t=1;; --quick) style=quick;; --grill) style=grill;;
      *) if [[ "$mode" == "@next" ]]; then mode="$a"; elif [[ -z "$name" ]]; then name="$a"; else wd_arg="$a"; fi;; esac
  done
  [[ -n "$name" ]] || die "usage: codebot plan <name> [workdir] [--mode <mode>] [--target <path>]... [--quick]   (modes: codebot modes)"
  S="$(sdir "$name")"; NAME="$name"
  if [[ ! -d "$S" ]]; then
    local wd; wd="$(readlink -f "${wd_arg:-$PWD}")"; [[ -d "$wd" ]] || die "no such dir: $wd"
    mkdir -p "$S"; echo "WORKDIR=\"$wd\"" > "$S/project.env"; touch "$S/PROGRESS.md" "$S/ANSWERS.md"
  fi
  [[ -n "$mode" ]] && ! grep -q '^MODE=' "$S/project.env" && echo "MODE=\"$mode\"" >> "$S/project.env"
  if (( ${#targets[@]} )) && ! grep -q '^SANDBOX_RO=' "$S/project.env"; then
    local t ro=""; for t in "${targets[@]}"; do ro+="$(readlink -f "$t"),"; done; echo "SANDBOX_RO=\"${ro%,}\"" >> "$S/project.env"
  fi
  load_proj "$name"; ensure_ollama
  cd "$RUNDIR" && exec env "OPENCODE_CONFIG=$OC_CONFIG" "$OPENCODE_BIN" --agent "$OC_AGENT" --prompt "$(PLAN_STYLE=$style render_prompt plan)" "$RUNDIR"
}

cmd_new() { # <name> <spec.md> [code dir]: a drafts project; the model writes the whole program from the spec and the spec's own examples judge it
  local name="${1:-}" spec="${2:-}" wd rc
  [[ -n "$name" && -n "$spec" ]] || die "usage: codebot new <name> <spec.md> [code dir]   (code dir: default the current dir, created if missing)"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "a project name is letters, digits, '.', '_' and '-'"
  [[ -f "$spec" ]] || die "no such spec file: $spec"
  S="$(sdir "$name")"; [[ -e "$S" ]] && die "project '$name' already exists (see: codebot status $name)"
  wd="$(readlink -f "${3:-$PWD}")"
  [[ "$wd" == "$CODEBOT_HOME" || "$wd" == "$CODEBOT_HOME"/* ]] && die "the code dir must be outside codebot's own folder ($CODEBOT_HOME)"
  "$ENGINE" check-spec "$spec" --home "$CODEBOT_HOME" ${3:+--code "$wd"}; rc=$?
  (( rc == 3 )) && die "not created: the code is too large for drafts mode"
  (( rc == 0 )) || die "not created: cannot read the spec"
  if [[ ! -d "$wd" ]]; then mkdir -p "$wd" || die "could not create $wd"; echo "created the code dir $wd"; fi
  mkdir -p "$S" && cp "$spec" "$S/SPEC.md" && printf 'WORKDIR="%s"\nWORKFLOW="drafts"\n' "$wd" > "$S/project.env" || die "could not create $S"
  echo; echo "created $name (code dir $wd). start it: codebot start $name"
}
cmd_check_spec() { [[ -n "${1:-}" ]] || die "usage: codebot check-spec <spec.md> [code dir]"; "$ENGINE" check-spec "$1" --home "$CODEBOT_HOME" ${2:+--code "$(readlink -f "$2")"}; }

cmd_start() {
  load_proj "${1:-}"
  if [[ "${WORKFLOW:-}" == shape ]]; then die "$NAME is still a design. Answer the questions, read the plan, then build it from the window (codebot gui)."; fi
  if [[ "${WORKFLOW:-}" == drafts ]]; then
    [[ -s "$S/SPEC.md" ]] || die "no SPEC.md in $S (create the project with: codebot new $NAME <spec.md>)"
    jq -e '.finished' "$S/drafts/state.json" >/dev/null 2>&1 && die "$NAME has finished: $(eng status --short). Review: codebot diff $NAME. A new run needs a new project (codebot new)"
  elif [[ "${WORKFLOW:-}" == pipeline ]]; then
    [[ -f "$S/pipeline/project.json" ]] || die "no pipeline/project.json (run: codebot pipeline design $NAME)"
  else
    [[ -s "$S/PLAN.md" ]] || die "no PLAN.md yet. run: codebot plan $NAME"
  fi
  alive "$S/loop.pid" && die "$NAME is already running"
  if [[ "${WORKFLOW:-}" != drafts && "${WORKFLOW:-}" != pipeline && ! -f "$S/tasks.json" ]] && grep -qE '^[[:space:]]+[-*][[:space:]]*check:' "$S/PLAN.md"; then
    echo "plan has per-task checks: freezing them (engine mode)"; "$ENGINE" freeze "$NAME" --home "$CODEBOT_HOME" || die "freeze failed: every task needs a check: line"
  fi
  [[ "${2:-}" == --keep ]] || rm -f "$S/PAUSE" "$S/STATUS"
  touch "$S/.active"
  if [[ "${2:-}" != --keep || ! -f "$S/env.snap" ]]; then # remember the launching shell's environment (JAVA_HOME, GHIDRA_INSTALL_DIR, PATH...) for the loop
    ( umask 077; export -p | grep -vE '^declare -[a-zA-Z-]+ (INVOCATION_ID|JOURNAL_STREAM|SYSTEMD_EXEC_PID|MANAGERPID|MAINPID|LISTEN_[A-Z]+|NOTIFY_SOCKET|SHLVL|OLDPWD|PWD|_|BASHOPTS|SHELLOPTS|BASH_[A-Z_]+|PPID|UID|EUID|TERM_PROGRAM_VERSION)=' > "$S/env.snap" )
  fi
  [[ "${WORKFLOW:-}" != drafts && "${WORKFLOW:-}" != pipeline && -z "$(verify_script)" ]] && echo "note: no verify.sh found; DONE will be accepted on the agent's word alone"
  ensure_ollama
  if [[ "${RUNDIR:-}" == "$S"/* && -d "$RUNDIR" ]]; then   # older layout: the worktree lived INSIDE the state dir, which the harness protects from the worker
    local moved="$CODEBOT_HOME/workspaces/$NAME"; mkdir -p "$CODEBOT_HOME/workspaces"
    git -C "$WORKDIR" worktree move "$RUNDIR" "$moved" && sed -i "s|^RUNDIR=.*|RUNDIR=\"$moved\"|" "$S/project.env" && RUNDIR="$moved" && echo "migrated the worktree out of the state dir: $moved"
  fi
  if [[ ! -f "$S/.git-prepped" ]]; then
    if git -C "$WORKDIR" rev-parse HEAD >/dev/null 2>&1; then
      # existing repo with history: isolate in a worktree so your checkout/uncommitted work is never touched
      RUNDIR="$CODEBOT_HOME/workspaces/$NAME"; mkdir -p "$CODEBOT_HOME/workspaces"     # NOT inside the state dir: the worker may only touch the code dir
      git -C "$WORKDIR" worktree add -q -b "codebot/$NAME" "$RUNDIR" 2>/dev/null \
        || git -C "$WORKDIR" worktree add -q "$RUNDIR" "codebot/$NAME" 2>/dev/null || [[ -d "$RUNDIR" ]] \
        || die "could not create worktree for codebot/$NAME"
      echo "RUNDIR=\"$RUNDIR\"" >> "$S/project.env"
      echo "isolated worktree: $RUNDIR (branch codebot/$NAME) - your checkout is untouched"
    else
      # brand-new / history-less folder: nothing to protect, work in place
      git -C "$WORKDIR" rev-parse --git-dir >/dev/null 2>&1 || git -C "$WORKDIR" init -q
      git -C "$WORKDIR" checkout -q -b "codebot/$NAME" 2>/dev/null || true
    fi
    touch "$S/.git-prepped"
  fi
  if [[ -n "${INVOCATION_ID:-}" ]] && command -v systemd-run >/dev/null; then
    # launched by a systemd unit (watchdog/login): run the loop in its own transient unit so it outlives the oneshot
    systemd-run --user --quiet --collect --unit="codebot-loop-$NAME-$(date +%s)" \
      --property=StandardOutput=append:"$S/loop.log" --property=StandardError=append:"$S/loop.log" \
      "$CODEBOT_HOME/bin/codebot" __loop "$NAME" || die "systemd-run failed"
    # the loop writes loop.pid itself; wait for it so a `stop` right after `start` finds the loop (2026-10-16: a cancelled benchmark left an orphan loop for 2.5 h)
    local i; for i in $(seq 1 100); do alive "$S/loop.pid" && break; sleep 0.1; done
    alive "$S/loop.pid" || echo "warning: $NAME loop did not report its pid within 10 s"
    echo "started $NAME (own systemd unit)"
  else
    setsid nohup "$0" __loop "$NAME" >> "$S/loop.log" 2>&1 &
    echo $! > "$S/loop.pid"
    echo "started $NAME (pid $!). watch: codebot log $NAME   pause: codebot pause $NAME"
  fi
}

verify_script() { # state-dir verify.sh preferred; fall back to one the model left in the code dir
  if [[ -f "$S/verify.sh" ]]; then echo "$S/verify.sh"; elif [[ -f "$RUNDIR/verify.sh" ]]; then echo "$RUNDIR/verify.sh"; fi
}
verify_gate() { # 0 = ok / no verify script
  local v; v="$(verify_script)"; [[ -n "$v" ]] || return 0
  local out; out="$(cd "$RUNDIR" && timeout 900 bash "$v" 2>&1)"; local rc=$?
  (( rc == 0 )) && return 0
  VERIFY_OUT="$(printf '%s' "$out" | tail -c 1200)"
  [[ -n "${VERIFY_OUT//[[:space:]]/}" ]] || VERIFY_OUT="verify.sh printed nothing and exited $rc. It checks the following; make every check true: $(grep -v '^#' "$v" | head -c 700)"
  return 1
}

tidy_memory() { # condense lessons.md with the model; restore on any sanity failure
  local f="$CODEBOT_HOME/memory/lessons.md" arch="$CODEBOT_HOME/memory/.archive"; mkdir -p "$arch"
  local bak="$arch/lessons-$(date +%F-%H%M%S).md"; cp "$f" "$bak"
  S="${S:-$CODEBOT_HOME}"; RUNDIR="$CODEBOT_HOME"
  timeout 900 "$OPENCODE_BIN" run --auto --agent codebot --dir "$CODEBOT_HOME/memory" \
    "Rewrite the file $f. Merge duplicates, drop anything project-specific or obsolete, keep only reusable lessons as short bullets (max 25 bullets, under 3000 characters), keep the first heading line. Edit only that file." \
    >> "$CODEBOT_HOME/logs/tidy.log" 2>&1 < /dev/null
  local n; n=$(wc -c < "$f")
  if (( n < 80 )) || ! head -1 "$f" | grep -q '^#' || (( n > $(wc -c < "$bak") + 200 )); then cp "$bak" "$f"; echo "tidy rejected, restored"; return 1; fi
  echo "lessons condensed: $(wc -c < "$bak") -> $n bytes (backup: $bak)"
}

ENGINE="$CODEBOT_HOME/bin/codebot-engine"
eng() { "$ENGINE" "$1" "$NAME" --home "$CODEBOT_HOME" "${@:2}"; }
has_blocked() { # engine projects keep blocked tasks in tasks.json; legacy projects use STATUS
  if [[ -f "$S/tasks.json" ]]; then [[ "$(jq '[.tasks[]|select(.status=="blocked")]|length' "$S/tasks.json" 2>/dev/null)" -gt 0 ]]
  else [[ -s "$S/STATUS" ]] && head -c 7 "$S/STATUS" | grep -q BLOCKED; fi
}

send_report() { # morning report: saved as projects/<name>/report-*.md, summary pushed through notify
  local path; path="$(eng report --write 2>/dev/null)" || return 0
  notify "codebot: $NAME morning report" "$(eng report --short 2>/dev/null)

Full report: $path" default memo
}

# supervisor for projects frozen with per-task checks: the harness (not the model) decides what happens next
loop_engine() {
  local ev kind pid out="$S/.step.out" blocked_seen="" idle_note="" vfails=0 idle="${IDLE_POLL:-15}"
  notify "codebot: $NAME started" "$(tasks_left) tasks to do (engine mode, per-task checks locked). Phone control: publish pause/resume/stop/status to $NTFY_TOPIC-reply" low rocket 1
  while [[ $finished == 0 ]]; do
    if [[ -f "$S/PAUSE" ]]; then phone_tick; sleep 5; continue; fi
    iter=$((iter+1)); echo "$iter" > "$S/iter.count"
    setsid flock "$CODEBOT_HOME/logs/model.lock" timeout $(( ITER_TIMEOUT + ${CHECK_TIMEOUT:-600} * 2 + 300 )) \
      "$ENGINE" step "$NAME" --home "$CODEBOT_HOME" > "$out" 2>> "$S/loop.log" < /dev/null &
    pid=$!; echo $pid > "$S/iter.pid"
    while kill -0 "$pid" 2>/dev/null; do phone_tick; sleep 3; done
    wait "$pid" 2>/dev/null; rm -f "$S/iter.pid"
    [[ $finished == 2 ]] && break
    if [[ -f "$S/PAUSE" ]]; then iter=$((iter-1)); echo "(step interrupted by pause)" >> "$S/loop.log"; continue; fi
    ev="$(tail -n1 "$out" 2>/dev/null)"; kind="$(jq -r '.event // "error"' <<< "$ev" 2>/dev/null || echo error)"
    echo "[engine] $(date '+%T') $kind $(jq -c 'del(.out_tail,.question,.tamper)' <<< "$ev" 2>/dev/null)" | tee -a "$S/loop.log" >/dev/null
    case "$kind" in
      task_done|task_failed) [[ "$(jq -r '.tamper|length' <<< "$ev")" -gt 0 ]] && notify "codebot: $NAME tamper detected" "A worker touched locked files ($(jq -c '.tamper' <<< "$ev")). They were restored and the attempt failed." high warning
        [[ "$kind" == task_done && "${NOTIFY_EACH_TASK:-0}" == 1 ]] && notify "codebot: $NAME" "$(jq -r .task <<< "$ev") verified ($(tasks_done) done, $(tasks_left) left)" min white_check_mark ;;
      task_split) notify "codebot: $NAME split a task" "$(jq -r .task <<< "$ev") kept failing, so it was split into $(jq -r '.children|join(", ")' <<< "$ev")." low scissors ;;
      task_blocked)
        local tid; tid="$(jq -r .task <<< "$ev")"
        if [[ "$blocked_seen" != *" $tid "* ]]; then blocked_seen="$blocked_seen $tid "
          notify "codebot: $NAME needs you ($tid)" "$(jq -r .question <<< "$ev")

(The run continues with other tasks. You can also answer from your phone via $NTFY_TOPIC-reply, e.g. \"$tid: your guidance\")" urgent sos 1; fi ;;
      task_timeout) notify "codebot: $NAME task timed out" "$(jq -r .root <<< "$ev") used its whole time budget ($(jq -r '(.used_s/60|floor)' <<< "$ev") min of $(jq -r '(.limit_s/60|floor)' <<< "$ev")). Unfinished: $(jq -r '.unfinished|join(", ")' <<< "$ev"); skipped dependents: $(jq -r '.skipped|join(", ")' <<< "$ev"). The run continues with independent tasks." default hourglass_flowing_sand ;;
      finished_incomplete)
        notify "codebot: $NAME finished (incomplete)" "Every task reached a final state but not all were verified: $(jq -c .counts <<< "$ev")" high warning
        send_report; finished=1; rm -f "$S/.active" ;;
      done_with_blocked|stalled)
        if [[ "$idle_note" != "$(jq -c .counts <<< "$ev")" ]]; then idle_note="$(jq -c .counts <<< "$ev")"
          notify "codebot: $NAME waiting on you" "Everything it can do is done. $(jq -r '.counts.blocked' <<< "$ev") blocked task(s) need an answer: codebot answer $NAME \"T#: guidance\"" high hourglass 1; send_report; fi
        phone_tick; sleep "$idle" ;;
      all_done)
        if ! verify_gate; then
          vfails=$((vfails+1))
          { echo; echo "## FINAL VERIFY FAILED ($(date '+%F %T')), attempt $vfails"; echo "$VERIFY_OUT"; } >> "$S/PROGRESS.md"
          if (( vfails >= 3 )); then
            notify "codebot: $NAME finished but final verification fails" "All task checks pass but $(verify_script) still fails after $vfails repair tasks. Last output: ${VERIFY_OUT:0:400}" urgent warning
            finished=1; rm -f "$S/.active"; break
          fi
          eng plan-op "$(jq -nc --arg c "$(cat "$(verify_script)")" --arg n "final_verify_$vfails.sh" --arg o "${VERIFY_OUT:0:600}" \
             '{op:"add_task", title:"Make the final verification script pass", check:("bash $CODEBOT_CHECKS/"+$n), fixtures:{($n):$c}, reason:("final verify.sh failed: "+$o)}')" --actor harness >/dev/null
          continue
        fi
        local mins=$(( ($(date +%s) - $(cat "$S/started.at" 2>/dev/null || date +%s)) / 60 ))
        notify "codebot: $NAME COMPLETE" "$(tasks_done) of $(( $(tasks_done) + $(tasks_left) )) tasks verified by their own locked checks. $iter attempts, $mins min total. Branch codebot/$NAME in $RUNDIR. Review: codebot diff $NAME. Last commit: $(git -C "$RUNDIR" log -1 --format=%s 2>/dev/null)" high white_check_mark
        send_report; finished=1; rm -f "$S/.active" ;;
      budget) notify "codebot: $NAME stopped by a budget" "$(jq -r '.kind + ": " + .message' <<< "$ev"). $(tasks_done) tasks done, $(tasks_left) left." high warning
        send_report; finished=1; rm -f "$S/.active" ;;
      *) notify "codebot: $NAME engine error" "$(jq -r '.error // "unexpected output"' <<< "$ev" 2>/dev/null | head -c 300)" high warning; finished=1; rm -f "$S/.active" ;;
    esac
  done
}

# A project that started as a design (shape.json) gets its closing review here, inside the loop, so it still runs and the person is still told when the window is closed.
_close_drafts() { # title body tag
  local note
  if [[ -f "$S/shape.json" ]]; then
    echo "[review] $(date '+%T') reading the code" >> "$S/loop.log"
    note="$(PYTHONPATH="$CODEBOT_HOME/lib${PYTHONPATH:+:$PYTHONPATH}" python3 -m codebot.shape review "$NAME" --home "$CODEBOT_HOME" 2>>"$S/loop.log")" \
      || note="The build finished. The closing review did not finish; the log has the reason."
    [[ -n "$note" ]] || note="$2"
    notify "codebot: $NAME is ready" "$note" high white_check_mark
  else
    notify "$1" "$2" high "$3"
  fi
  send_report; finished=1; rm -f "$S/.active"
}

# supervisor for WORKFLOW=pipeline: one harness step (at most one model call) per iteration
loop_pipeline() {
  local ev st pid rc asked= out="$S/.step.out"
  notify "codebot: $NAME started" "Pipeline run (one model call at a time). status: codebot pipeline status $NAME" low rocket 1
  while [[ $finished == 0 ]]; do
    if [[ -f "$S/PAUSE" ]]; then phone_tick; sleep 5; continue; fi
    iter=$((iter+1)); echo "$iter" > "$S/iter.count"
    setsid flock "$CODEBOT_HOME/logs/model.lock" timeout $(( ITER_TIMEOUT + 1800 )) \
      env PYTHONPATH="$CODEBOT_HOME/lib${PYTHONPATH:+:$PYTHONPATH}" python3 -m codebot.pipeline step "$NAME" --home "$CODEBOT_HOME" > "$out" 2>> "$S/loop.log" < /dev/null &
    pid=$!; echo $pid > "$S/iter.pid"
    while kill -0 "$pid" 2>/dev/null; do phone_tick; sleep 3; done
    wait "$pid" 2>/dev/null; rc=$?; rm -f "$S/iter.pid"
    [[ $finished == 2 ]] && break
    if [[ -f "$S/PAUSE" ]]; then iter=$((iter-1)); echo "(pipeline step interrupted by pause)" >> "$S/loop.log"; continue; fi
    ev="$(tail -n1 "$out" 2>/dev/null)"; st="$(jq -r '.status // "error"' <<< "$ev" 2>/dev/null || echo error)"
    echo "[pipeline] $(date '+%T') $st $(jq -c 'del(.run)' <<< "$ev" 2>/dev/null)" >> "$S/loop.log"
    case "$st" in
      COMPLETED) notify "codebot: $NAME COMPLETE" "Pipeline finished. Review: codebot pipeline status $NAME" default white_check_mark; finished=1; rm -f "$S/.active" ;;
      FAILED) notify "codebot: $NAME failed" "$(jq -r '.error // "pipeline failed"' <<< "$ev" 2>/dev/null | head -c 300)" high warning; finished=1; rm -f "$S/.active" ;;
      WAITING_APPROVAL) [[ -n "$asked" ]] || notify "codebot: $NAME needs approval" "Approve: codebot pipeline approve $NAME (or the Pipeline page)." default hand
                        asked=1; sleep 30 ;;   # one push, not one every 30 s while it waits
      BUSY) sleep 15 ;;
      CANCELLED) finished=1; rm -f "$S/.active" ;;
      *) asked= ;;
    esac
  done
}

# supervisor for drafts projects: one round (one model call, one judged version) per engine step; the engine keeps the state between steps
loop_drafts() {
  local ev kind pid rc out="$S/.step.out" timeouts=0
  if [[ -f "$S/shape.json" ]]; then notify "codebot: $NAME started" "Building it now. You will be told when it is ready." low rocket 1
  else notify "codebot: $NAME started" "Writing the whole program from SPEC.md, judged by the spec's own examples. $(eng status --short 2>/dev/null). Phone control: publish pause/resume/stop/status to $NTFY_TOPIC-reply" low rocket 1; fi
  while [[ $finished == 0 ]]; do
    if [[ -f "$S/PAUSE" ]]; then phone_tick; sleep 5; continue; fi
    iter=$((iter+1)); echo "$iter" > "$S/iter.count"
    setsid flock "$CODEBOT_HOME/logs/model.lock" timeout $(( ITER_TIMEOUT + 1800 )) \
      "$ENGINE" step "$NAME" --home "$CODEBOT_HOME" > "$out" 2>> "$S/loop.log" < /dev/null &
    pid=$!; echo $pid > "$S/iter.pid"
    while kill -0 "$pid" 2>/dev/null; do phone_tick; sleep 3; done
    wait "$pid" 2>/dev/null; rc=$?; rm -f "$S/iter.pid"
    [[ $finished == 2 ]] && break
    if [[ -f "$S/PAUSE" ]]; then iter=$((iter-1)); echo "(round interrupted by pause)" >> "$S/loop.log"; continue; fi
    ev="$(tail -n1 "$out" 2>/dev/null)"; kind="$(jq -r '.event // "error"' <<< "$ev" 2>/dev/null || echo error)"
    (( rc == 124 )) && kind=timeout
    echo "[drafts] $(date '+%T') $kind $(jq -c . <<< "$ev" 2>/dev/null)" >> "$S/loop.log"
    case "$kind" in
      round) timeouts=0 ;;
      model_error) sleep 30 ;;          # the engine counts these and ends the run after five in a row
      timeout) timeouts=$((timeouts+1))
        if (( timeouts >= 3 )); then notify "codebot: $NAME stopped" "Three rounds in a row ran past $(( (ITER_TIMEOUT + 1800) / 60 )) min. $(eng status --short 2>/dev/null)" high warning; finished=1; rm -f "$S/.active"; fi ;;
      all_done) _close_drafts "codebot: $NAME COMPLETE" "$(eng report --short 2>/dev/null) Branch codebot/$NAME in $RUNDIR. Review: codebot diff $NAME" white_check_mark ;;
      finished_incomplete) _close_drafts "codebot: $NAME finished (not every example passes)" "$(eng report --short 2>/dev/null) Branch codebot/$NAME in $RUNDIR. Review: codebot diff $NAME" warning ;;
      *) notify "codebot: $NAME engine error" "$(jq -r '.error // "unexpected output (see codebot log)"' <<< "$ev" 2>/dev/null | head -c 300)" high warning; finished=1; rm -f "$S/.active" ;;
    esac
  done
}

cmd___loop() {
  S="$(sdir "$1")"; [[ -f "$S/env.snap" ]] && source <(sed "s/^declare -x /declare -gx /" "$S/env.snap") 2>/dev/null
  load_proj "$1"; local iter stall=0 verify_fails=0 t0=$SECONDS notified_block=0 pid; finished=0
  iter=$(cat "$S/iter.count" 2>/dev/null || echo 0)
  [[ -f "$S/started.at" ]] || date +%s > "$S/started.at"
  echo $$ > "$S/loop.pid"
  trap 'finished=2' TERM INT
  trap '[[ $finished == 0 ]] && notify "codebot: $NAME loop crashed" "Loop exited unexpectedly. Check codebot log $NAME" high warning; rm -f "$S/loop.pid" "$S/iter.pid"' EXIT
  if [[ "${WORKFLOW:-}" == drafts ]]; then loop_drafts; return; fi      # drafts project: whole-program rounds
  if [[ "${WORKFLOW:-}" == pipeline ]]; then loop_pipeline; return; fi  # modular team graph (lib/codebot/pipeline)
  if [[ -f "$S/tasks.json" ]]; then loop_engine; return; fi      # frozen project: the engine owns the state machine
  notify "codebot: $NAME started" "$(tasks_left) tasks to do in $RUNDIR. Phone control: publish pause/resume/stop/status to $NTFY_TOPIC-reply" low rocket 1
  while (( iter < MAX_ITERATIONS )) && [[ $finished == 0 ]]; do
    if [[ -f "$S/PAUSE" ]]; then phone_tick; sleep 5; continue; fi
    local st=""; [[ -f "$S/STATUS" ]] && st="$(head -c 1500 "$S/STATUS")"
    if [[ "$st" == DONE* ]]; then
      if ! verify_gate; then
        verify_fails=$((verify_fails+1)); rm -f "$S/STATUS"
        { echo; echo "## VERIFY FAILED ($(date '+%F %T')), attempt $verify_fails"; echo "$VERIFY_OUT"; } >> "$S/PROGRESS.md"
        if (( verify_fails >= 3 )); then echo "BLOCKED: verify.sh still fails after $verify_fails attempts. Last output: $VERIFY_OUT" > "$S/STATUS"
        else echo "- [ ] Fix the failing verification: read the VERIFY FAILED section at the end of $S/PROGRESS.md, fix the code, run bash $(verify_script) until it exits 0" >> "$S/PLAN.md"; fi
        echo "(verify failed, attempt $verify_fails)"; continue
      fi
      local total=$(tasks_done)/$(( $(tasks_done) + $(tasks_left) )) vmsg="no verify.sh (agent's word only)" mins
      [[ -n "$(verify_script)" ]] && vmsg="verify.sh passed"
      mins=$(( ($(date +%s) - $(cat "$S/started.at" 2>/dev/null || date +%s)) / 60 ))
      notify "codebot: $NAME COMPLETE" "Tasks $total checked off, $vmsg. $iter iterations, $mins min total. Branch codebot/$NAME in $RUNDIR. Review: codebot diff $NAME. Last commit: $(git -C "$RUNDIR" log -1 --format=%s 2>/dev/null)" high white_check_mark
      finished=1; rm -f "$S/.active"; break
    elif [[ "$st" == BLOCKED* ]]; then
      if (( ! notified_block )); then
        notify "codebot: $NAME needs you" "$st

Reply by sending your answer to the topic $NTFY_TOPIC-reply in the ntfy app, or: codebot answer $NAME \"...\"" urgent sos 1; notified_block=1
      fi
      phone_tick; sleep 10; continue
    fi
    notified_block=0
    if [[ "$(tasks_left)" == 0 ]]; then echo "DONE" > "$S/STATUS"; continue; fi
    if (( $(wc -c < "$CODEBOT_HOME/memory/lessons.md") > LESSONS_MAX )); then echo "(condensing lessons.md)"; tidy_memory >> "$S/loop.log" 2>&1; fi
    iter=$((iter+1)); echo "$iter" > "$S/iter.count"; local before after; before="$(state_hash)"
    echo "=== iteration $iter $(date '+%F %T') | tasks left: $(tasks_left) ==="
    setsid flock "$CODEBOT_HOME/logs/model.lock" timeout "$ITER_TIMEOUT" env "OPENCODE_CONFIG=$OC_CONFIG" "$OPENCODE_BIN" run --auto --thinking ${THINK_VARIANT:+--variant "$THINK_VARIANT"} --agent "$OC_AGENT" --dir "$RUNDIR" --title "$NAME #$iter" \
      "$(render_prompt work)" >> "$S/loop.log" 2>&1 < /dev/null &
    pid=$!; echo $pid > "$S/iter.pid"
    # small models sometimes keep rambling after finishing: once STATUS appears, give it 20s then end the iteration
    local seen=0
    while kill -0 "$pid" 2>/dev/null; do
      if [[ -s "$S/STATUS" ]]; then (( seen++ >= 4 )) && { kill -TERM -- "-$pid" 2>/dev/null; pkill -TERM -P "$pid" 2>/dev/null; break; }; fi
      phone_tick; sleep 5
    done
    wait "$pid" 2>/dev/null; rm -f "$S/iter.pid"
    [[ $finished == 2 ]] && break
    if [[ -f "$S/PAUSE" ]]; then iter=$((iter-1)); echo "$iter" > "$S/iter.count"; echo "(iteration interrupted by pause)"; continue; fi
    after="$(state_hash)"
    if [[ "$before" == "$after" ]]; then stall=$((stall+1)); else stall=0; fi
    if (( stall >= STALL_LIMIT )) && [[ ! -f "$S/STATUS" ]]; then
      echo "BLOCKED: no progress for $stall iterations in a row (model stuck or looping). See loop.log." > "$S/STATUS"; stall=0
    fi
  done
  if [[ $finished == 0 ]]; then
    notify "codebot: $NAME hit iteration cap" "Stopped after $iter iterations with $(tasks_left) tasks left." high warning; finished=1; rm -f "$S/.active"
  fi
}

kill_tree() { # TERM a process and every descendant (process groups are not reliable under systemd-run)
  local p="$1" c; for c in $(pgrep -P "$p" 2>/dev/null); do kill_tree "$c"; done; kill -TERM "$p" 2>/dev/null; return 0
}
kill_iter() { # stop the step/iteration the loop is currently running, if any
  [[ -f "$S/iter.pid" ]] || return 0
  local p; p="$(cat "$S/iter.pid")"; kill -TERM -- "-$p" 2>/dev/null; kill_tree "$p"
}
cmd_pause() {
  load_proj "${1:-}"; touch "$S/PAUSE"
  if [[ "${2:-}" == --soft ]]; then echo "paused after the current iteration finishes"; return; fi
  kill_iter
  "$OLLAMA_BIN" stop "$CODEBOT_MODEL" >/dev/null 2>&1
  echo "paused: iteration stopped, model unloaded (RAM freed). resume: codebot resume $NAME"
}
cmd_resume() { load_proj "${1:-}"; alive "$S/loop.pid" || die "loop not running; use: codebot start $NAME"; ensure_ollama; rm -f "$S/PAUSE"; echo "resumed $NAME"; }
cmd_answer() { load_proj "${1:-}"; shift; [[ -n "${*:-}" ]] || die "usage: codebot answer <name> <text>"
  if [[ -f "$S/tasks.json" ]]; then eng answer "$*" | jq -r 'if .released then "recorded; " + .released + " unblocked and back on the ladder" else "recorded (no blocked task was waiting)" end'; return; fi
  { echo; echo "## $(date '+%F %T') (answer to: $(head -c 300 "$S/STATUS" 2>/dev/null))"; echo "$*"; } >> "$S/ANSWERS.md"
  rm -f "$S/STATUS"; echo "recorded; loop will continue"; }
cmd_stop() { load_proj "${1:-}"; if alive "$S/loop.pid"; then local p; p=$(cat "$S/loop.pid"); touch "$S/PAUSE"
    kill_iter; kill -TERM "$p"; sleep 1; kill -9 "$p" 2>/dev/null
    rm -f "$S/loop.pid" "$S/iter.pid" "$S/PAUSE" "$S/.active"; "$OLLAMA_BIN" stop "$CODEBOT_MODEL" >/dev/null 2>&1; echo "stopped $NAME"; else echo "$NAME not running"; fi; }
cmd_log() { load_proj "${1:-}"; tail -n "${2:-60}" -f "$S/loop.log"; }
cmd_list() { for d in "$CODEBOT_HOME"/projects/*/; do [[ -f "$d/project.env" ]] || continue; n=$(basename "$d"); cmd_status "$n"; done; }
cmd_status() { [[ -n "${1:-}" ]] || { cmd_list; return; }; load_proj "$1"; local s=stopped
  alive "$S/loop.pid" && { s=running; [[ -f "$S/PAUSE" ]] && s=PAUSED; }
  if [[ "${WORKFLOW:-}" == shape ]]; then echo "$NAME: designing (open it with codebot gui)"; return; fi
  if [[ "${WORKFLOW:-}" == drafts ]]; then echo "$NAME: $s | $(eng status --short 2>/dev/null) | $WORKDIR"; return; fi
  local eng=""; [[ -f "$S/tasks.json" ]] && eng=" [engine: $(jq -r '[.tasks[]|.status]|group_by(.)|map("\(.[0]) \(length)")|join(", ")' "$S/tasks.json" 2>/dev/null)]"
  echo "$NAME: $s | done $(tasks_done) / left $(tasks_left)$eng | status: $(head -c 120 "$S/STATUS" 2>/dev/null || true) | $WORKDIR"; }
cmd_resume_all() { # at login and every 5 min (watchdog): restart loops that should be running but are not
  for d in "$CODEBOT_HOME"/projects/*/; do
    [[ -f "$d/.active" ]] || continue; local n; n=$(basename "$d")
    [[ "$n" == cap-* ]] && continue   # a benchmark trial: its runner (below) decides about the loop
    alive "$d/loop.pid" && continue
    echo "restarting $n (loop was not running)"
    NAME="$n"; cmd_start "$n" --keep >/dev/null && notify "codebot: $n restarted" "The loop had died (crash, out-of-memory kill or reboot). Restarted it; it resumes from the plan files." high recycle 1
  done
  for d in "$CODEBOT_HOME"/bench/results/ladder/*/; do   # benchmark runs whose runner died (reboot, crash): resume keeps finished trials and every task's consumed time
    [[ -f "$d/.active" ]] || continue; local r; r=$(basename "$d")
    local out; out=$("$CODEBOT_HOME/bin/codebot-bench" --home "$CODEBOT_HOME" resume "$r" --auto 2>&1) || continue   # the runner checks for itself whether it is alive (pid reuse after a reboot); --auto never undoes a cancel
    [[ "$out" == resuming* ]] && { echo "$out" | head -1; notify "codebot: benchmark $r resumed" "The benchmark runner had died. Resumed it; finished trials and consumed task time are kept." high recycle 1; }
  done
}
cmd_install_service() {
  local u="$HOME/.config/systemd/user"; mkdir -p "$u"
  cat > "$u/codebot.service" <<UNIT
[Unit]
Description=codebot: restart active loops that are not running

[Service]
Type=oneshot
ExecStart=$CODEBOT_HOME/bin/codebot resume-all

[Install]
WantedBy=default.target
UNIT
  cat > "$u/codebot.timer" <<UNIT
[Unit]
Description=codebot watchdog (login + every 5 min)

[Timer]
OnStartupSec=1min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
UNIT
  systemctl --user daemon-reload && systemctl --user enable codebot.service codebot.timer >/dev/null 2>&1 && systemctl --user start codebot.timer \
    && echo "installed: loops that die or survive a reboot are restarted (checked at login and every 5 min)"
}
cmd_re_config() { "$CODEBOT_HOME/bin/codebot-mkconfig" --refresh; }
cmd_prompt() { load_proj "${1:-}"; PLAN_STYLE="${3:-${PLAN_STYLE:-grill}}" render_prompt "${2:-plan}"; }
cmd_freeze() { need_proj "${1:-}"; "$CODEBOT_HOME/bin/codebot-engine" freeze "$1" --home "$CODEBOT_HOME" "${@:2}"; }
cmd_engine() { local sub="${1:-}"; need_proj "${2:-}"; "$CODEBOT_HOME/bin/codebot-engine" "$sub" "$2" --home "$CODEBOT_HOME" "${@:3}"; }
cmd_report() { load_proj "${1:-}"; if [[ "${2:-}" == --send ]]; then send_report; echo "report saved and pushed"; else eng report "${@:2}"; fi; }
cmd_check_plan() { need_proj "${1:-}"; "$ENGINE" check-plan "$1" --home "$CODEBOT_HOME"; }
cmd_bench() { exec "$CODEBOT_HOME/bin/codebot-bench" --home "$CODEBOT_HOME" "$@"; }
cmd_modes() { "$ENGINE" modes x --home "$CODEBOT_HOME"; }
cmd_audit() { need_proj "${1:-}"; "$ENGINE" audit "$1" --home "$CODEBOT_HOME" "${@:2}"; }
cmd_tidy() {   # evidence-backed memory needs no model: prune lessons that correlate with failure and regenerate lessons.md
  if [[ -f "$CODEBOT_HOME/memory/lessons.raw.jsonl" ]]; then
    local first; first="$(ls "$CODEBOT_HOME/projects" 2>/dev/null | head -1)"
    [[ -n "$first" ]] && "$ENGINE" memory "$first" --home "$CODEBOT_HOME" && return
  fi
  ensure_ollama; tidy_memory; }
cmd_diff() { load_proj "${1:-}"; git -C "$RUNDIR" log --oneline "codebot/$NAME" -n 20 2>/dev/null; echo; git -C "$WORKDIR" diff --stat "HEAD...codebot/$NAME" 2>/dev/null || git -C "$RUNDIR" diff --stat
  echo; echo "merge when happy:  git -C $WORKDIR merge codebot/$NAME     (worktree: $RUNDIR)"; }
cmd_notify() { # <title> <message> [priority] [tags]: push through the same ntfy path (and egress log) the loops use; honours NTFY_ENABLED
  [[ -n "${2:-}" ]] || die "usage: codebot notify <title> <message> [priority] [tags]"; notify "$1" "$2" "${3:-default}" "${4:-robot}"; }
cmd_notify_test() { notify "codebot test" "ntfy is working" default white_check_mark; echo "sent to $NTFY_SERVER (topic not shown)"; }

[[ $# -eq 0 && -t 0 ]] && exec "$CODEBOT_HOME/bin/codebot-ui"
c="${1:-help}"; shift || true
case "$c" in
  setup|new|plan|start|pause|resume|answer|stop|log|list|status|tidy|diff|prompt|freeze|engine|audit|modes|report|__loop) "cmd_$c" "$@";;
  check-plan) cmd_check_plan "$@";;
  check-spec) cmd_check_spec "$@";;
  bench) cmd_bench "$@";;
  eval) exec "$CODEBOT_HOME/bin/codebot-eval" "$@";;
  doctor) exec "$CODEBOT_HOME/bin/codebot-doctor" "$@";;
  notify) cmd_notify "$@";;
  notify-test) cmd_notify_test;;
  resume-all) cmd_resume_all;;
  re-config) cmd_re_config;;
  install-service) cmd_install_service;;
  ui|menu) exec "$CODEBOT_HOME/bin/codebot-ui";;
  gui) PYTHONPATH="$CODEBOT_HOME/lib${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m codebot.gui --home "$CODEBOT_HOME" "$@";;
  pipeline) PYTHONPATH="$CODEBOT_HOME/lib${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m codebot.pipeline "$@";;
  *) cat <<'USAGE'
codebot - local-only autonomous coding agent for small offline models (run with no arguments for the menu)
  new <name> <spec.md> [dir]   a project from a spec (recommended): the model writes the whole program, judged by the spec's own examples;
                          restarts when stuck, keeps the best version (committed on branch codebot/<name>). Then: start <name>
  check-spec <spec.md> [dir]   which requirements have examples (only those are checked) and whether the code fits that mode
  plan <name> [workdir] [--mode <m>] [--target <path>] [--quick]   interactive planning ("grill me" interview; --quick = short; --re = --mode re)
  check-plan <name>       test every check in PLAN.md against the code as it is now (a check that already passes, or is broken, is rejected and logged)
  freeze <name> [--allow-unchecked] [--allow-passing-checks]   lock per-task checks and create tasks.json (`start` does this automatically)
  start <name>            freeze if needed, then run the autonomous loop in the background
  status [name] | list    show state
  log <name>              follow the loop log
  pause <name> [--soft]   stop now and free RAM (or --soft: after the current step)
  resume <name>           continue after pause
  stop <name>             end the loop
  answer <name> <text>    answer a blocked task ("T3: guidance"); resets its ladder
  report <name> [--send|--short|--json]   morning report: done, blocked (exact question), diffs to review, lessons, time, safety
  audit <name> [--probe]  what ran and changed, proof of offline operation (--probe tries the network from inside the sandbox)
  diff <name>             what codebot changed and how to merge it
  prompt <name> [plan|work] [quick]   print the exact prompt the model receives
  modes                   list the modes (folders under modes/)
  tidy                    prune lessons that correlate with failure and regenerate memory/lessons.md
  bench --preflight       prove the context setup against the live model server (num_ctx, keep_alive, schema, KV cache)
  bench [--suite pyutils|pyhard] [--plan fixed|auto] [--name N] [--max-minutes M] [--record]   run a suite through the real pipeline and record metrics
  bench list | run --level N | run --suite ladder [--repeats 3] | run --suite growing | status [run] | report [run] | resume [run] | cancel [run]
                          Capability Ladder Benchmark: 12 levels + a growing project, each planned task gets its own 90 min (no limit on the whole run); see docs/BENCHMARK.md
  bench --thermal [--minutes M] [--only substr] [--record]   sweep threads / power profile / GPU configs for sustained speed vs heat
  re-config               rebuild the REA agent config after editing config/rea-tools.txt
  install-service         install the watchdog timer (restarts loops that die; keeps pauses and pending questions)
  eval mutants|gate|planner   model evaluation: mutant sets, a speed/compatibility gate per model, scored planner probes (docs/MODEL_EVAL.md)
  doctor                  is this machine ready? (prerequisites, Ollama, model, sandbox image, notification settings)
  gui [--port N] [--open]  the local window, on this machine only (describe a project, answer a few questions, then build)
  pipeline validate <file.json>...   validate modular team/workflow JSON (docs/architecture/modular-agent-orchestration.md)
  pipeline init|design|step|run|status|cancel|approve <name>   install template / design / step / run / status / cancel / approve
  resume-all              (watchdog) restart active loops that are not running
  setup | notify-test     start the private Ollama / send a test ntfy message
  notify <title> <msg> [priority] [tags]   push one ntfy message through the normal path (used by `bench run` for completion/timeout/critical alerts)
  engine <cmd> <name>     low-level access to codebot-engine (step, plan-op, split, sizing, memory, ...)
  (phone) publish pause|resume|stop|status|<answer> to <ntfy topic>-reply
USAGE
;;
esac
