#!/usr/bin/env python3
"""codebot-engine: structured task engine. Usage: codebot-engine freeze|step|status|render <project> [--allow-unchecked]"""
import argparse, json, os, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from codebot.config import Project
from codebot import engine, tasks as T

def main():
    ap = argparse.ArgumentParser(prog="codebot-engine")
    ap.add_argument("cmd", choices=["freeze", "step", "status", "render", "reset", "plan-op", "split", "sizing"])
    ap.add_argument("project"); ap.add_argument("op_json", nargs="?"); ap.add_argument("--actor", default="user"); ap.add_argument("--allow-unchecked", action="store_true")
    ap.add_argument("--home"); ap.add_argument("--fresh", action="store_true")
    a = ap.parse_args()
    proj = Project(a.project, a.home)
    if a.cmd == "freeze":
        d = engine.freeze_project(proj, a.allow_unchecked or bool(proj.get("ALLOW_UNCHECKED")))
        print(f"frozen {proj.name}: {len(d['tasks'])} tasks, checks locked in checks.lock")
    elif a.cmd == "step":
        print(json.dumps(engine.step(proj, fresh=a.fresh)))
    elif a.cmd == "status":
        s = T.TaskStore(proj)
        if not s.exists(): print(json.dumps({"frozen": False})); return
        d = s.load(); print(json.dumps({"frozen": True, "counts": T.counts(d)}))
    elif a.cmd == "plan-op":
        from codebot import planops
        print(json.dumps(planops.apply(proj, json.loads(a.op_json), a.actor)))
    elif a.cmd == "split":
        from codebot import sizing
        print(json.dumps(sizing.auto_split(proj, a.op_json, actor=a.actor)))
    elif a.cmd == "sizing":
        from codebot import sizing
        print(sizing.advice_line(proj))
    elif a.cmd == "reset":
        print("reset to " + str(engine.reset(proj)))
    elif a.cmd == "render":
        s = T.TaskStore(proj); T.render_plan(proj, s.load()); print("PLAN.md re-rendered")

if __name__ == "__main__": main()
