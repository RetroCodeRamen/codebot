#!/usr/bin/env python3
"""codebot-engine: structured task engine. Usage: codebot-engine freeze|step|status|render <project> [--allow-unchecked]"""
import argparse, json, os, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from codebot.config import Project
from codebot import engine, tasks as T

def main():
    ap = argparse.ArgumentParser(prog="codebot-engine")
    ap.add_argument("cmd", choices=["freeze", "step", "status", "render", "reset", "plan-op", "split", "sizing", "answer", "memory", "audit", "mode-info", "prompt-template", "modes", "report", "check-plan"])
    ap.add_argument("project"); ap.add_argument("op_json", nargs="?"); ap.add_argument("--actor", default="user"); ap.add_argument("--allow-unchecked", action="store_true"); ap.add_argument("--probe", action="store_true"); ap.add_argument("--quick", action="store_true"); ap.add_argument("--json", action="store_true"); ap.add_argument("--short", action="store_true"); ap.add_argument("--allow-passing-checks", action="store_true"); ap.add_argument("--write", action="store_true")
    ap.add_argument("--home"); ap.add_argument("--fresh", action="store_true")
    a = ap.parse_intermixed_args()
    if a.cmd == "modes":
        from codebot import modes, config
        for d in modes.describe(a.home or config.home_dir()): print(f"{d['name']:<10} {d['engine']:<9} {('extends ' + d['extends']) if d['extends'] else '':<14} {d['description']}")
        return
    proj = Project(a.project, a.home)
    if a.cmd == "freeze":
        d = engine.freeze_project(proj, a.allow_unchecked or bool(proj.get("ALLOW_UNCHECKED")), a.allow_passing_checks)
        print(f"frozen {proj.name}: {len(d['tasks'])} tasks, checks locked in checks.lock")
    elif a.cmd == "step":
        print(json.dumps(engine.step(proj, fresh=a.fresh)))
    elif a.cmd == "status":
        s = T.TaskStore(proj)
        if not s.exists(): print(json.dumps({"frozen": False})); return
        d = s.load(); print(json.dumps({"frozen": True, "counts": T.counts(d)}))
    elif a.cmd == "plan-op":
        from codebot import planops
        print(json.dumps(planops.apply(proj, json.loads(a.op_json), a.actor)))
    elif a.cmd == "check-plan":
        from codebot import guard, planparse
        with open(proj.p("PLAN.md")) as f: _, tasks = planparse.parse_plan(f.read())
        res = guard.evaluate(proj, tasks); bad = [r for r in res if r["verdict"] != "ok"]
        for r in res: print(f"{r['id']:<6} {'OK  (fails now: a real test)' if r['verdict'] == 'ok' else r['verdict'].upper():<30} {r['title'][:50]}")
        missing = [t["id"] for t in tasks if t["status"] != "done" and not (t.get("check") or "").strip()]
        for m in missing: print(f"{m:<6} {'NO CHECK':<30}")
        for r in bad: guard.log_rejection(proj, r["id"], r["title"], r["check"], r["verdict"], r["out"], "planner")
        if bad: print("\n" + guard.message(proj, bad).split("\n", 1)[1])
        print("OK" if not bad and not missing else "REJECTED"); sys.exit(1 if bad or missing else 0)
    elif a.cmd == "report":
        from codebot import report
        r = report.build(proj)
        if r is None: print(f"{proj.name} is not an engine project (no tasks.json): freeze it to get reports", file=sys.stderr); sys.exit(2)
        if a.write: print(report.write(proj, r))
        elif a.json: print(json.dumps(r))
        elif a.short: print(report.short(r))
        else: print(report.markdown(r))
    elif a.cmd == "mode-info":
        from codebot import modes
        try: m = modes.load(proj.home, proj.mode); print(json.dumps({k: v for k, v in m.items() if k != "chain"}))
        except modes.ModeError as e: print(str(e), file=sys.stderr); sys.exit(2)
    elif a.cmd == "prompt-template":
        from codebot import modes
        try: sys.stdout.write(modes.prompt_template(proj.home, proj.mode, a.op_json or "work", a.quick))
        except modes.ModeError as e: print(str(e), file=sys.stderr); sys.exit(2)
    elif a.cmd == "audit":
        from codebot import audit, sandbox
        pr = sandbox.probe(proj) if a.probe else None
        r = audit.report(proj, pr); print(json.dumps(r) if a.json else audit.render(r))
        sys.exit(1 if (r["warnings"] or not r["chain_ok"]) else 0)
    elif a.cmd == "memory":
        from codebot import memory
        pr = memory.prune(proj.home); memory.rebuild_md(proj.home); print(json.dumps({**memory.summary(proj.home), "newly_pruned": pr}))
    elif a.cmd == "answer":
        print(json.dumps(engine.answer(proj, a.op_json or "")))
    elif a.cmd == "split":
        from codebot import sizing
        print(json.dumps(sizing.auto_split(proj, a.op_json, actor=a.actor)))
    elif a.cmd == "sizing":
        from codebot import sizing
        print(sizing.advice_line(proj))
    elif a.cmd == "reset":
        print("reset to " + str(engine.reset(proj)))
    elif a.cmd == "render":
        s = T.TaskStore(proj); T.render_plan(proj, s.load()); print("PLAN.md re-rendered")

if __name__ == "__main__": main()
