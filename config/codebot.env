# codebot configuration (sourced by bash)
CODEBOT_MODEL="codebot-model"          # built from config/Modelfile (ornith:9b + 32k ctx)
OLLAMA_PORT=11500                      # private ollama, separate from system ollama (:11434)
NTFY_SERVER="https://ntfy.sh"
NTFY_TOPIC="codebot-tahlokffwnfdc7"                    # subscribe to this topic in the ntfy app
ITER_TIMEOUT=2700                      # max seconds for one loop iteration (45 min)
MAX_ITERATIONS=300                     # hard cap per run
STALL_LIMIT=3                          # iterations with zero progress before "I'm stuck" ping
LESSONS_MAX=4000                       # bytes; above this, lessons.md is auto-condensed
THINK=off                              # off = loop runs without hidden reasoning (about 10x faster on this CPU; tool calls and notes still stream). on = visible thinking, slow. Planning chat always thinks.
PLAN_STYLE=grill                       # grill = thorough "grill me" interview (default); quick = short 2-round interview
