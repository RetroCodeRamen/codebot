# codebot configuration (sourced by bash)
CODEBOT_MODEL="codebot-model"          # built from config/Modelfile (ornith:9b + 32k ctx)
OLLAMA_PORT=11500                      # private ollama, separate from system ollama (:11434)
NTFY_SERVER="https://ntfy.sh"           # ntfy server for pushes (the harness is the only thing that ever talks to it)
NTFY_TOPIC="codebot-tahlokffwnfdc7"                    # subscribe to this topic in the ntfy app
ITER_TIMEOUT=2700                      # max seconds for one loop iteration (45 min)
MAX_ITERATIONS=300                     # hard cap per run
STALL_LIMIT=3                          # iterations with zero progress before "I'm stuck" ping
LESSONS_MAX=4000                       # bytes; above this, lessons.md is auto-condensed
THINK=off                              # off = loop runs without hidden reasoning (about 10x faster on this CPU; tool calls and notes still stream). on = visible thinking, slow. Planning chat always thinks.
PLAN_STYLE=grill                       # grill = thorough "grill me" interview (default); quick = short 2-round interview

# --- engine mode (projects frozen with per-task checks; see docs/ROADMAP.md) ---
WORKER=native                          # native = built-in constrained-output worker (JSON-schema actions, edits validated before they land)
CONTEXT_BUDGET=8000                    # tokens of context the harness packs for each attempt (of the 32k window)
WORKER_MAX_TURNS=24                    # model turns per attempt
WORKER_CONTEXT_TOKENS=22000            # compact the conversation when it grows past this
WORKER_TEMPERATURE=0.2                 # sampling temperature of the worker (the alternate-prompt rung uses ALT_TEMPERATURE)
RUN_TIMEOUT=120                        # seconds for one command the worker runs
LADDER_TRIES="2,2,0,2,1"               # attempts per rung: retry / fresh retry / split / alternate prompt / larger model
ALT_TEMPERATURE=0.8                    # temperature on the alternate-prompt rung
#ESCALATE_MODEL=                       # optional larger local model for the last rung before blocking
TASK_MAX_ATTEMPTS=8                    # hard cap per task, then blocked + a question to you
STUCK_SAME_FAILURE=3                   # identical check failure this many times in a row = stuck
STUCK_NO_PROGRESS=6                    # attempts in a row with no task completing = stuck
PINGPONG_WINDOW=6                      # attempts examined for a file being edited back and forth
PROJECT_MAX_MINUTES=0                  # wall-clock cap per project (0 = none)

# --- offline sandbox + audit ---
SANDBOX=auto                           # docker = require the Docker sandbox; auto = use it if available (audit shows if not); none = off
SANDBOX_IMAGE="ubuntu:24.04"           # an image that is ALREADY local (never pulled); the host's /usr is mounted read-only over it
SANDBOX_MEMORY=2g                      # memory cap for sandboxed commands
#SANDBOX_RO=/home/aj/.local/jdk-21,/home/aj/.local/ghidra_12.1.4_PUBLIC   # extra read-only mounts (reverse-engineering mode)
NTFY_ENABLED=1                         # 0 = the harness sends nothing off this machine at all
PHONE_CONTROL=1                        # 0 = stop polling the ntfy reply topic
CHECK_BASELINE_GUARD=1                  # reject a check that already passes (or is broken) before it is frozen
REGRESSION_GATE=1                       # a task only counts as done when every task already done still passes its check
PLAN_PER_ITEM=1                         # unattended planner: one model call per numbered spec item (0 = one call for the whole plan)

# --- context + thermal ---
NUM_CTX=32768                          # must equal the Modelfile's num_ctx and opencode's limit.context (a test enforces it); sent on every request
KEEP_ALIVE=30m                         # sent on every request: the model stays loaded between turns
THERMAL_GUARD=1                        # pause model calls while the CPU package is too hot
THERMAL_MAX=92                         # C: pause at or above this
THERMAL_RESUME=84                      # C: continue once at or below this

# --- less common keys (all optional; any of them can also be set per project in projects/<p>/project.env) ---
#CHECK_TIMEOUT=600                     # seconds for one acceptance check
#ALLOW_UNCHECKED=1                     # accept tasks without a check (the project-level verify.sh is then the only gate)
#WORKER_CMD=                           # replace the native worker with your own command (tests use this); contract in lib/codebot/engine.py run_worker
#SPLIT_CMD=                            # replace the task splitter (prints JSON {"subtasks":[...]}); SPLITTER=mechanical disables the model-driven splitter
#WORKER_MAX_TOKENS=1800                # generation limit per worker turn (a cut-off reply is reported as such and the model is told to do less per step)
#SANDBOX_PIDS=512  SANDBOX_PASS_ENV=VIRTUAL_ENV   # sandbox process limit / extra env passed in
#THERMAL_MAX_WAIT=1800                 # never pause longer than this many seconds for the CPU to cool
#IDLE_POLL=15                          # seconds between checks while the loop waits for your answer
#NOTIFY_EACH_TASK=1                    # push a low-priority notification for every verified task
#NTFY_TOKEN=                           # bearer token for a protected ntfy topic
